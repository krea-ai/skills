# Internal research dumps (competitor recon, scratch). Never publish.
research/

# Eval results — write-only local cache, never committed.
# The bare `runs/` pattern matches at any depth, so it also covers
# evals/hero/runs/ (verified via `git check-ignore`).
runs/

# Hero-eval reference images live in evals/hero/fixtures/ and ARE committed —
# small, non-sensitive fixtures the cases reference by local path; lint checks they exist.
# (Cases without a committed image still use Krea-hosted/placeholder URLs instead.)

# Local env (API keys for eval runner, etc.)
.env.local
.env.*.local
