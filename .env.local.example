# Copy to .env.local and fill in. .env.local is gitignored.
#
# ANTHROPIC_API_KEY — only needed if `claude -p` headless invocations can't use
# your existing Claude Code OAuth login. Most setups don't need it; if eval runs
# fail with auth errors, set this and re-run.
# ANTHROPIC_API_KEY=sk-ant-...

# KREA_API_KEY — only needed for the standalone Python scripts
# (krea-ai/scripts/pipeline.py, krea-ai/scripts/train_style.py). The MCP-backed
# skills do NOT need this; the MCP handles auth on its own.
# Get one at https://krea.ai/settings/api-tokens
# (Legacy KREA_API_TOKEN is still accepted as a fallback, but deprecated.)
# KREA_API_KEY=...
