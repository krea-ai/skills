# Copy to .env.local and fill in. .env.local is gitignored.
#
# ANTHROPIC_API_KEY — only needed if `claude -p` headless invocations can't use
# your existing Claude Code OAuth login. Most setups don't need it; if eval runs
# fail with auth errors, set this and re-run.
# ANTHROPIC_API_KEY=sk-ant-...

# KREA_API_KEY — optional fallback for Krea CLI auth and custom direct-HTTP
# experiments. Normal skill use prefers `krea auth login`; MCP-backed flows use
# the connected MCP server's auth.
# Get one at https://krea.ai/settings/api-tokens
# KREA_API_KEY=...
